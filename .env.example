# Local Docker POC only. Copy this file to .env (never commit .env).
NMC_HOST_PORT=4200
NMC_DEV_HOST_PORT=4201

# Airia API key: issued separately by the AI partner.
# Leave empty to run the unchanged NMC screens in mock mode.
AIRIA_MENA_KEY=

# Optional override for Airia regional API.
AIRIA_BASE_URL=https://api.mena.airia.ai

# Verified non-secret pipeline IDs from MOEI Airia partner catalogue (17 Oct 2026).
# These are mappings only: AI execution stays opt-in and requires credentials.
AIRIA_A01_PIPELINE_ID=86904bc8-e552-4172-aaa8-1a79cbb9539d
AIRIA_A02_PIPELINE_ID=73708937-ba16-47e3-b404-55cc0a54b159
AIRIA_A03_PIPELINE_ID=603d32f6-2f5f-42a8-a592-77af571a2480
AIRIA_A04_PIPELINE_ID=bad751da-0e11-48fd-861d-5bde1afbbd8d
AIRIA_NMC_DQ01_PIPELINE_ID=c9f3b21d-dce6-4e66-81f2-db15fdb23256
AIRIA_SI_C01_PIPELINE_ID=f0799e63-387e-44dd-a451-cdffef96ee0d
AIRIA_SI_S01_PIPELINE_ID=eee9e630-ec5c-4ad8-b23e-59119696f837
AIRIA_SI_V01_PIPELINE_ID=5006d8c4-f8b5-4811-b767-704daab16e6a
AIRIA_SI_R01_PIPELINE_ID=d0efe143-96ee-4fc0-8f15-93cc81ac97d3
AIRIA_SI_X01_PIPELINE_ID=b82d5bb0-3e84-4265-b8ed-8eb38989b30f
AIRIA_CONVERSATIONAL_SI_PIPELINE_ID=e1b776b8-62a4-43e2-abdb-9c114b74d9a1
AIRIA_NMC_DESK_PIPELINE_ID=f332642a-a180-4935-908f-8868984dfcb7
AIRIA_SDB_JOURNEY_PIPELINE_ID=d0b0036d-e8a2-4596-9a65-32164a2b59a7

# SI-P01 is retired for this POC; no dedicated pipeline was supplied.
# Checklist Builder and per-question checklist Vision remain unmapped because
# the catalogue does not confirm compatible structured-output contracts.
SI_AI_PROVIDER=mock
SI_CHECKLIST_AIRIA_ENABLED=false
AIRIA_SI_CHECKLIST_BUILDER_PIPELINE_ID=
AIRIA_SI_CHECKLIST_VISION_PIPELINE_ID=

# Explicit opt-in required before any paid A04 pre-inspection dossier requests.
SI_A04_ENABLED=false

# External Port State Control simulation (420 fictional vessels).
# 'snapshot' works immediately with NO Google credentials.
# 'google_sheets' requires the private compose.google-psc.yaml override.
PSC_SOURCE_MODE=snapshot
PSC_GOOGLE_SHEET_ID=1sefQv6E-Avvgmklv4WQbpFBEc7MmlCAcOc0c-rI_Wmg

# Central dashboard workspace (write operations remain disabled until configured).
# Generate TWO different random secrets, 24+ characters each. Never commit actual values.
# Generate one key on Windows PowerShell:\n# $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)\n# Run twice for two different keys.
NMC_DASHBOARD_EDITOR_KEY=
NMC_DASHBOARD_PUBLISHER_KEY=

# SI-P01 on-demand inspection ranking: OFF by default to prevent billable calls.
# Enable only after Airia provides and verifies a P01 pipeline and contract.
SI_P01_ENABLED=false
AIRIA_SI_P01_PIPELINE_ID=
