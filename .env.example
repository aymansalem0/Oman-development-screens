# Local Docker POC only. Copy this file to .env (never commit .env).
NMC_HOST_PORT=4200
NMC_DEV_HOST_PORT=4201

# Airia API key: issued separately by the AI partner.
# Leave empty to run the unchanged NMC screens in mock mode.
AIRIA_MENA_KEY=

# Optional override for Airia regional API.
AIRIA_BASE_URL=https://api.mena.airia.ai
# Explicit opt-in required before any paid A04 pre-inspection dossier requests.
SI_A04_ENABLED=false

# External Port State Control simulation (420 fictional vessels).
# 'snapshot' works immediately with NO Google credentials.
# 'google_sheets' requires the private compose.google-psc.yaml override.
PSC_SOURCE_MODE=snapshot
PSC_GOOGLE_SHEET_ID=1sefQv6E-Avvgmklv4WQbpFBEc7MmlCAcOc0c-rI_Wmg

# Central dashboard workspace (write operations remain disabled until configured).
# Generate TWO different random secrets, 24+ characters each. Never commit actual values.
# Generate one key on Windows PowerShell:\n# $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)\n# Run twice for two different keys.
NMC_DASHBOARD_EDITOR_KEY=
NMC_DASHBOARD_PUBLISHER_KEY=

# SI-P01 on-demand inspection ranking: OFF by default to prevent billable calls.
# Enable only after Airia provides and verifies a P01 pipeline and contract.
SI_P01_ENABLED=false
AIRIA_SI_P01_PIPELINE_ID=
