# Angular development with hot reload via Docker Desktop bind mount.
FROM node:20-alpine
WORKDIR /workspace
COPY package*.json ./
RUN npm install --no-audit --no-fund
COPY . .
EXPOSE 4200
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--port", "4200", "--poll", "1000", "--proxy-config", "proxy.conf.json"]
